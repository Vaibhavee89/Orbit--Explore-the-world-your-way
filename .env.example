# ---------------------------------------------------------------
# Orbit – environment variable template
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.
# ---------------------------------------------------------------

# ── Adventure Mode (ACTIVE) ────────────────────────────────────

# Adventure Mode uses free Cesium Ion 3D tiles (OpenStreetMap + Cesium World Terrain).
# No API key is required for the free tier.
# For production or higher usage limits, get a free Cesium Ion token:
# https://cesium.com/ion/
VITE_CESIUM_ION_TOKEN=

# Backend URL for the Worldbuilder service (geo-fenced quest generation, etc.)
# Leave blank during local development; the feature is not yet implemented.
VITE_WORLDBUILDER_API_URL=

# ── Travel Mode (DISABLED, kept for reference) ────────────────

# To enable Travel Mode, pass ?mode=travel in the URL: http://localhost:5173/?mode=travel
#
# Travel Mode requires:
# - Google Maps JavaScript / Geocoding / Directions / Street View APIs
#   Get a key at https://console.cloud.google.com/apis/credentials
# - OpenAI GPT-4o / GPT-4o-mini
#   Get a key at https://platform.openai.com/api-keys
#
# Uncomment below if you want to re-enable Travel Mode:
# GOOGLE_MAPS_API_KEY=
# OPENAI_API_KEY=
