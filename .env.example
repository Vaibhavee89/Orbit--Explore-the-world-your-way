# ---------------------------------------------------------------
# Orbit – environment variable template
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.
# ---------------------------------------------------------------

# ── Adventure Mode (ACTIVE) ────────────────────────────────────

# Adventure Mode's map uses Leaflet + OpenStreetMap tiles — completely free,
# no API key required. The 5 featured destinations (Manali, Rajasthan,
# Iceland, Kyoto, Swiss Alps) are hand-authored local worlds that load
# instantly and also need no key or backend.

# Base URL for the Worldbuilder backend (only used for non-featured/custom
# regions built from real OSM+elevation data). Defaults to
# http://localhost:8000 if left blank — only set this to point at a
# different backend host.
VITE_WORLDBUILDER_API_URL=

# ── Travel Mode (DISABLED, kept for reference) ────────────────

# To enable Travel Mode, pass ?mode=travel in the URL: http://localhost:5173/?mode=travel
#
# Travel Mode requires:
# - Google Maps JavaScript / Geocoding / Directions / Street View APIs
#   Get a key at https://console.cloud.google.com/apis/credentials
# - OpenAI GPT-4o / GPT-4o-mini
#   Get a key at https://platform.openai.com/api-keys
#
# Uncomment below if you want to re-enable Travel Mode:
# GOOGLE_MAPS_API_KEY=
# OPENAI_API_KEY=
