# ---------------------------------------------------------------
# Orbit – environment variable template
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.
# ---------------------------------------------------------------

# ── Travel Mode ────────────────────────────────────────────────

# Google Maps JavaScript / Geocoding / Directions / Street View APIs
# Get a key at https://console.cloud.google.com/apis/credentials
# Required APIs: Maps JavaScript API, Geocoding API, Directions API, Street View API
GOOGLE_MAPS_API_KEY=

# OpenAI GPT-4o / GPT-4o-mini – used by the AI travel assistant
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Adventure Mode ─────────────────────────────────────────────

# Restricted Google Maps Tiles API key for Cesium 3D tiles (Adventure Mode).
# Create a SEPARATE key restricted to: Map Tiles API only +
# HTTP referrers: localhost:3000/*, localhost:5173/*, your-prod-domain/*.
# Falls back to VITE_GOOGLE_MAPS_API_KEY → GOOGLE_MAPS_API_KEY if blank,
# but a dedicated restricted key is recommended for production.
# Verify: curl "https://tile.googleapis.com/v1/3dtiles/root.json?key=YOUR_KEY" → 200
VITE_MAP_TILES_API_KEY=

# Vite-prefixed alias for the Google Maps key (used by other Adventure Mode modules
# via import.meta.env.VITE_GOOGLE_MAPS_API_KEY).
# Leave blank to fall back to GOOGLE_MAPS_API_KEY automatically.
VITE_GOOGLE_MAPS_API_KEY=

# Backend URL for the Worldbuilder service (geo-fenced quest generation, etc.)
# Leave blank during local development; the feature is not yet implemented.
VITE_WORLDBUILDER_API_URL=
